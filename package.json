{
  "name": "@gorundebug/tsnativeexample",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage test/**/*.test.ts",
    "test:diagnostics": "node scripts/test-node-diagnostics.mjs",
    "test:event-loop-stress": "node --import tsx --test acceptance/event-loop-stress.test.ts",
    "typecheck": "tsc -b --pretty false",
    "check": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm format:check"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "@confluentinc/kafka-javascript": "1.9.0",
    "@grpc/grpc-js": "1.14.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
